# =====================================================================
# Align 백엔드 환경변수 예시 (실제 값은 절대 커밋하지 마세요)
# 이 저장소는 아키텍처 회고용 발췌본이며, 그대로 실행되지 않습니다.
# =====================================================================

# --- 서버 포트 ---
MAIN_PORT=60007
MESSAGE_PORT=60008
UPLOAD_PORT=60006

# --- MySQL ---
DB_HOST=your-mysql-host
DB_USER=your-db-user
DB_PASSWORD=change-me
DB_NAME=your-db-name
DB_PORT=3306

# --- Redis / ElastiCache ---
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# --- MongoDB ---
MONGODB_URI=mongodb+srv://user:password@cluster.example.net/dbname

# --- 인증 (JWT) ---
JWT_SECRET=generate-a-long-random-string
REFRESH_SECRET=generate-another-long-random-string

# --- 민감정보 암호화 (AES-256-CBC) ---
ENCRYPTION_KEY=64-hex-chars-32-bytes
ENCRYPTION_IV=32-hex-chars-16-bytes

# --- AWS (S3 업로드 / SES) ---
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=your-bucket

# --- Toss Payments ---
TOSS_SECRET_KEY=test_sk_xxx

# --- 관측성 ---
OTEL_SERVICE_NAME=gh-main-server
OTLP_ENDPOINT=http://jaeger:4318/v1/traces

# --- 로그 알림 (log_watcher.sample.sh) ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
